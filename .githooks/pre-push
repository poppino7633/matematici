#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(git rev-parse --show-toplevel)
temporary_dir=$(mktemp -d)
trap 'rm -rf "$temporary_dir"' EXIT
while read -r local_ref local_oid remote_ref remote_oid; do
  if [[ "$local_oid" =~ ^0+$ ]]; then
    continue
  fi
  commit=$(git rev-parse "$local_oid^{commit}")
  if [[ -d "$temporary_dir/$commit" ]]; then
    continue
  fi
  mkdir -p "$temporary_dir/$commit/source"
  git archive "$commit" | tar -x -C "$temporary_dir/$commit/source"
  echo "Verificare LaTeX pentru $local_ref ($commit)"
  if ! bash "$repo_dir/scripts/build-pdfs.sh" \
    "$temporary_dir/$commit/source" "$temporary_dir/$commit/output"; then
    echo 'Push oprit: compilarea LaTeX a eșuat.' >&2
    exit 1
  fi
done
